{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/dashboard/assets/$1" },
    { "source": "/dashboard/assets/(.*)", "destination": "/dashboard/assets/$1" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
