    "chaos:pool": "bash ./scripts/chaos-inject.sh pool-exhaustion",
    "chaos:reset": "bash ./scripts/chaos-inject.sh reset"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}
